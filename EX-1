import java.util.Scanner;
class EB
{  
  string name,type;
  int cno,prev,cur;
     
  void setInput()
  {
     Scanner s=new Scanner(System.in);
     System.out.println("Customer Details:");
     System.out.println("Enter Customer Name:");
     cname=s.nextLine();
     System.out.println("Enter connection type:");
